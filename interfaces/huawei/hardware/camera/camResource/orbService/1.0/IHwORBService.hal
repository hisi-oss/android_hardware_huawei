package vendor.huawei.hardware.camera.camResource.orbService@1.0;

interface IHwORBService {
     oneway stop();

     oneway start();

     oneway connect(IHwORBServiceCallback callback);

     process(HwORBParam data) generates (uint32_t result, int32_t error)

     oneway disconnect(IHwORBServiceCallback callback);
};
